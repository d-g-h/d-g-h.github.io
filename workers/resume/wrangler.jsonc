{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "private-resume",
  "main": "entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "resume.pxl8.ing", "custom_domain": true }],
  "observability": { "enabled": false },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "RESUME_DATABASE", "class_name": "ResumeDatabase" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResumeDatabase"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "private-resume-files" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "PUBLIC_ORIGIN": "https://resume.pxl8.ing" },
}
